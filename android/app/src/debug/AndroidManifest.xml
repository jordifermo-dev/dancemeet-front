<?xml version="1.0" encoding="utf-8"?>
<!-- Merged only into debug builds - adds the debug-only network security
     config (see res/xml/network_security_config.xml) without touching the
     main manifest, so release builds are unaffected. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
