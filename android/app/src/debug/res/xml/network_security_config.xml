<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (src/debug/, merged only into debug variants) - lets
     the app trust a locally-installed CA certificate (e.g. Norton's
     SSL-inspection root, same root cause as the Gradle sync failures) so
     HTTPS calls work while developing behind that kind of network. Release
     builds never include this file, so Google Play builds keep the normal
     system-only trust behavior. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- TEMP dev-only: lets the WebView reach `ng serve`/Nest over plain
         HTTP via `adb reverse` (capacitor.config.ts's dev server: block) -
         scoped to localhost only, and only merged into debug builds. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
